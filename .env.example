# Application Environment Variables
APP_URL="MY_APP_URL"
PORT=3000

# Google AI Studio / Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Cloud SQL PostgreSQL runtime credentials (automatically injected by Google AI Studio)
# SQL_HOST="127.0.0.1"
# SQL_DB_NAME="ai_studio"
# SQL_USER="ai_studio_user"
# SQL_PASSWORD="secret_password"
# SQL_ADMIN_USER="ai_studio_admin"
# SQL_ADMIN_PASSWORD="secret_admin_password"

# Optional external service credentials
# VITE_GOOGLE_MAPS_KEY=""
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
