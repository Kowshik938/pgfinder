# PGFinder Configuration Template
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to public version control.

# Application Server
PORT=3000
NODE_ENV=production
APP_URL=https://your-app-domain.com

# Authentication & Security
# Cryptographically random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters

# Google AI Studio / Gemini API Key (Server-side only)
# Used for AI Roommate Compatibility Matching and PG Discovery Concierge
GEMINI_API_KEY=your_gemini_api_key

# PostgreSQL / Cloud SQL Database Configuration
SQL_HOST=127.0.0.1
SQL_PORT=5432
SQL_DB_NAME=pgfinder
SQL_USER=your_db_user
SQL_PASSWORD=your_db_password
SQL_ADMIN_USER=your_admin_user
SQL_ADMIN_PASSWORD=your_admin_password

# Public Client-Side Variables (Vite prefixes exposed to browser)
# Only put non-sensitive, public identifiers here
VITE_APP_NAME=PGFinder
VITE_APP_TAGLINE="Curated Tech Hub Living"
# VITE_GOOGLE_MAPS_KEY=optional_public_maps_key
